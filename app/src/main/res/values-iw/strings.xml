    <!-- Training guide -->
    <string name="guide_title">אימון מילת הפעלה משלך</string>
    <string name="guide_intro">אפשר ליצור מילת הפעלה לבחירתך, בכל שפה, עם מחברת האימון החינמית של openWakeWord ב-Google Colab. זה לוקח כשעה ולא דורש תכנות.</string>
    <string name="guide_step_1">פתח את מחברת האימון (בכפתור למטה) והתחבר עם חשבון Google.</string>
    <string name="guide_step_2">הזן את מילת ההפעלה בשדה המילה (target word). השתמש באותיות לטיניות (ראה טיפים למטה).</string>
    <string name="guide_step_3">הרץ את התא שמייצר דוגמאות קול והאזן להן. אם זה לא נשמע כמו המילה שלך, שנה את האיות ונסה שוב.</string>
    <string name="guide_step_4">הרץ את שאר התאים כדי לאמן את המודל. בסיום, הורד את קובץ ה-tflite.</string>
    <string name="guide_step_5">העתק את הקובץ למכשיר, הקש \"ייבוא מודל…\" בהגדרות ותן לו שם.</string>
    <string name="guide_open_notebook">פתח את מחברת האימון</string>
    <string name="guide_tips_title">טיפים למילים שאינן באנגלית</string>
    <string name="guide_tip_phonetic">כתוב את המילה פונטית באותיות לטיניות, כפי שדובר אנגלית היה קורא אותה.</string>
    <string name="guide_tip_sounds">הימנע מצלילים שאין באנגלית (למשל ח, או ר גרונית). בחר מילה שנשמעת דומה בלעדיהם.</string>
    <string name="guide_tip_syllables">העדף 3 עד 4 הברות. מילים קצרות גורמות ליותר הפעלות שגויות.</string>
    <string name="guide_tip_listen">תמיד האזן לדוגמאות שנוצרו לפני האימון המלא.</string>

