<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BayitVoice" parent="android:Theme.Material.NoActionBar" />

    <!-- The session sheet floats over whatever is on screen (or the lock screen). -->
    <style name="Theme.BayitVoice.Session" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowBackgroundFallback">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The idle screen: black from the first frame, so it never flashes white. -->
    <style name="Theme.BayitVoice.Idle" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
